READINESS_APP_ENV=production
READINESS_APP_DEBUG=0
READINESS_APP_URL=https://readiness.example.mil

READINESS_DB_DRIVER=mysql
READINESS_DB_HOST=127.0.0.1
READINESS_DB_PORT=3306
READINESS_DB_NAME=readiness
READINESS_DB_USER=readiness_user
READINESS_DB_PASS=change-me
READINESS_DB_CONNECT_TIMEOUT=5
# READINESS_DB_SOCKET=/var/run/mysqld/mysqld.sock
# READINESS_DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

READINESS_TRUST_PROXY_HEADERS=1
READINESS_SESSION_NAME=readiness_session
READINESS_SESSION_IDLE_TIMEOUT=3600
READINESS_SESSION_ABSOLUTE_TIMEOUT=43200

READINESS_API_MAX_BODY_BYTES=65536
READINESS_API_RATE_LIMIT_PER_MINUTE=60
READINESS_API_REQUIRE_CLIENT_KEY=1
# READINESS_API_ALLOWED_IPS=10.0.0.0/24,10.10.10.10